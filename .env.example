# Database Connection (PostgreSQL / Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/veyra?schema=public"

# Express Server Port (Local Development)
PORT=5001

# JWT Secret Key for Session Cookies
JWT_SECRET="veyra-secret-key-change-in-production-2026"

# Allowed Frontend URL for CORS (Production)
FRONTEND_URL="http://localhost:5173"
CLIENT_URL="http://localhost:5173"

# Node Environment
NODE_ENV="development"
